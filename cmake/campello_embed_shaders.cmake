# Script mode (cmake -P): writes OUTPUT, a header embedding the compiled
# binaries of shader program NAME. See CampelloRendererShaders.cmake.
set(slots METAL VULKAN_VERTEX VULKAN_FRAGMENT DIRECTX_VERTEX DIRECTX_FRAGMENT)
set(text "// Generated by campello_renderer_add_shader_program(${NAME}). Do not edit.\n#pragma once\n\n#include <campello_renderer/program.hpp>\n\nnamespace ${NAME}_shaders {\n\n")
foreach(slot ${slots})
    string(TOLOWER "${slot}" lower)
    if(DEFINED ${slot} AND EXISTS "${${slot}}")
        file(READ "${${slot}}" hex HEX)
        string(LENGTH "${hex}" hexLength)
        math(EXPR size "${hexLength} / 2")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(REGEX REPLACE "((0x..,){16})" "\\1\n    " bytes "${bytes}")
        string(APPEND text "static const unsigned char k_${lower}[] = {\n    ${bytes}\n};\nstatic const unsigned long long k_${lower}_size = ${size};\n\n")
    else()
        string(APPEND text "static const unsigned char k_${lower}[] = {0};\nstatic const unsigned long long k_${lower}_size = 0;\n\n")
    endif()
endforeach()
string(APPEND text "inline systems::leal::campello_renderer::ShaderProgramDesc desc() {
    using namespace systems::leal::campello_renderer;
    ShaderProgramDesc d;
    d.name = \"${NAME}\";
    d.metalLibrary = {k_metal, k_metal_size};
    d.vulkanVertex = {k_vulkan_vertex, k_vulkan_vertex_size};
    d.vulkanFragment = {k_vulkan_fragment, k_vulkan_fragment_size};
    d.directxVertex = {k_directx_vertex, k_directx_vertex_size};
    d.directxFragment = {k_directx_fragment, k_directx_fragment_size};
    d.vertexReads = ${VERTEX_READS};
    return d;
}

} // namespace ${NAME}_shaders
")
file(WRITE "${OUTPUT}" "${text}")
