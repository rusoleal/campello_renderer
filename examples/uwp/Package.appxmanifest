<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">

  <Identity Name="campello.rendereruwp" Publisher="CN=campello" Version="1.0.0.3" />

  <mp:PhoneIdentity PhoneProductId="b2f4a1d6-7c35-4e8a-9d10-3c6e5f8a2b47" PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>campello renderer</DisplayName>
    <PublisherDisplayName>campello</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <!-- Windows.Universal, so the same package runs on a Windows PC and an Xbox. -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="campello_renderer_uwp.App">
      <uap:VisualElements
        DisplayName="campello renderer"
        Description="campello_renderer on UWP"
        Square150x150Logo="Assets\Logo150.png"
        Square44x44Logo="Assets\Logo44.png"
        BackgroundColor="#202020">
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#202020" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
